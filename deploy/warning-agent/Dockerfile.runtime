FROM node:22.22.0-bookworm-slim

WORKDIR /opt/deepseek-harness

ARG NPM_REGISTRY=https://npm.nie.netease.com/
ARG BUILD_RUNTIME_ARTIFACTS=true
ENV npm_config_registry=${NPM_REGISTRY}

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate \
    && pnpm config set registry "${NPM_REGISTRY}" \
    && groupadd --system --gid 10001 warning-agent \
    && useradd --system --uid 10001 --gid warning-agent --home-dir /var/lib/warning-agent warning-agent

COPY --chown=warning-agent:warning-agent . .
RUN CI=true pnpm install --frozen-lockfile
# Workspace packages publish their runtime entrypoints from lib/. Build the
# CLI dependency graph and warning-agent bundle before switching to the
# non-root runtime user; the source checkout alone is not a deployable image.
RUN if [ "${BUILD_RUNTIME_ARTIFACTS}" = "true" ]; then \
      node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b \
        apps/cli/tsconfig.json packages/bundle/warning-agent/tsconfig.json --pretty false \
      && pnpm exec tsdown --config apps/cli/tsdown.config.ts; \
    else \
      test -f apps/cli/lib/bin.js \
      && test -f packages/bundle/warning-agent/lib/startup.js; \
    fi

USER warning-agent
ENV NODE_ENV=production \
    DSH_HOME=/var/lib/warning-agent/.dsh

EXPOSE 8090
VOLUME ["/var/lib/warning-agent/sessions"]
ENTRYPOINT ["pnpm", "dsh", "--profile", "warning-agent"]
