# AI Agent Server 环境变量配置
# 复制此文件为 .env 并填写实际值

# 服务配置
PORT=3000
NODE_ENV=production

# API 认证（留空则跳过鉴权）
API_KEY=your-secret-key-here

# LLM / Harness 配置
# Harness CLI 路径（dsh 命令）
HARNESS_CLI=/usr/local/bin/dsh

# LLM API（Harness 内部使用，需配置 DSH_HOME 下的 credentials）
LLM_API_URL=https://token.sensenova.cn/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=sensenova-6.8-flash-lite

# 文件存储
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
THUMBNAIL_DIR=./thumbnails
LOG_DIR=./logs
TEMP_DIR=./temp

# CLI 配置
PHOTOCRAFT_CLI=/usr/local/bin/photocraft-cli
TASK_TIMEOUT=60000
