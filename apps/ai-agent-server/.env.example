# AI Agent Server 环境变量配置
# 复制此文件为 .env 并填写实际值

# 服务配置
PORT=3000
NODE_ENV=production

# API 认证（留空则跳过鉴权）
API_KEY=your-secret-key-here

# LLM / Harness 配置
# Harness CLI 路径（dsh 命令）
HARNESS_CLI=/usr/local/bin/dsh
# 置 true 后 /api/parse 优先走 harness agent（dsh headless --json），支持一句话多次图片修改。
# config.ts 用 dotenv override:true 让本文件覆盖进程环境里已存在的同名变量，避免踩到旧 LLM URL。
HARNESS_ENABLED=true

# LLM API（SiliconFlow OpenAI 兼容端点；harness-agent 经 llm-pi-ai 注入此路由）
LLM_API_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# PhotoCraft CLI serve gateway（真实 Rust 引擎，JSON-RPC over loopback TCP）
PHOTOCRAFT_SERVE_PORT=7878
PHOTOCRAFT_SERVE_TOKEN=change-me
PHOTOCRAFT_SERVE_ROOT=/opt/ai-agent-server
PHOTOCRAFT_SERVE_BIN=/usr/local/bin/photocraft-cli-real

# 文件存储
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
THUMBNAIL_DIR=./thumbnails
LOG_DIR=./logs
TEMP_DIR=./temp

# CLI 配置
PHOTOCRAFT_CLI=/usr/local/bin/photocraft-cli
TASK_TIMEOUT=60000
