# Copy to .env and replace every required placeholder before starting Compose.
AGENT_GATEWAY_WARNING_CENTER_CALLBACK_URL=http://warning-center:8080/internal/v1/warning-agent/task-events
AGENT_GATEWAY_WARNING_CENTER_TOKEN=replace-with-internal-token
WARNING_AGENT_SHARED_SECRET=replace-with-a-long-random-secret

AGENT_GATEWAY_PUBLISHED_PORT=8080
AGENT_GATEWAY_MAX_REQUEST_BYTES=262144
AGENT_GATEWAY_MAX_CONCURRENT_REQUESTS=64
WARNING_AGENT_MAX_CONCURRENT_TASKS=4
WARNING_AGENT_TASK_TIMEOUT_MS=600000
WARNING_AGENT_RETENTION_MS=604800000
WARNING_AGENT_CALLBACK_RETRY_ATTEMPTS=3
WARNING_AGENT_CALLBACK_RETRY_BACKOFF_MS=250

# Optional immutable image names used by a release pipeline.
AGENT_GATEWAY_IMAGE=warning-agent/agent-gateway:local
WARNING_AGENT_RUNTIME_IMAGE=warning-agent/runtime:local
