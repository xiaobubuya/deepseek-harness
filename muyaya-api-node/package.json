{
  "name": "muyaya-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Muyaya Album API - Node.js version with local storage and SQLite",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test/smoke.mjs",
    "init-db": "node scripts/init-db.js",
    "deploy": "npm install --production && pm2 restart muyaya-api"
  },
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^11.0.0",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "sharp": "^0.33.0",
    "crypto": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
